[Unit]
Description=Deerstop wildlife camera detection
After=network-online.target
Wants=network-online.target
# The interpreter, venv, and model live on the external /media/pol/pond disk.
# Ensure that mount is ready before starting (systemd does not infer this from
# the ExecStart path), otherwise a cold boot can race the mount and fail.
RequiresMountsFor=/media/pol/pond

[Service]
Type=simple
User=pol
WorkingDirectory=/home/pol/ws/deerstop/detection
Environment=PYTHONUNBUFFERED=1
ExecStart=/media/pol/pond/ws/deerstop_compile/venv/bin/python stream_yolo.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
